{
  "name": "zoutkaap-erp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Middleware tussen de Zoutkaap-webshop en het ERP: voorraadsync, orderdoorgifte, retry en idempotentie, statuspagina en logging.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run src"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
